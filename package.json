{
  "name": "piku-down-tauri",
  "version": "1.7.0",
  "private": true,
  "description": "Piku Down Tauri2＋Rust迁移版",
  "license": "MIT",
  "scripts": {
    "start": "tauri dev",
    "build": "tauri build",
    "build:x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:x86": "tauri build --target i686-pc-windows-msvc",
    "build:arm64": "tauri build --target aarch64-pc-windows-msvc",
    "build:all": "pnpm build:x64 && pnpm build:x86 && pnpm build:arm64",
    "test": "cargo test -p piku-core && node --test test/*.test.js",
    "test:legacy": "node --test test/*.test.js",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
